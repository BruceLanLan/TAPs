      "reject": "integer -9007199254740992 at .n is outside the exactly representable range; carry it as a string"
    },
    {
      "input": "{\"n\":-0.0}",
      "reject": "negative zero at .n: it serialises as 0 and the two forms are not distinguishable"
    },
    {
